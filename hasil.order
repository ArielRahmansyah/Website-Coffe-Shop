<!DOCTYPE html>
<html>

<head>
    <title>Hasil Pesanan Kopi Senja</title>
    <style>
        body {
            background-color: #FFF8F0;
            color: #3E2723;
            font-family: Arial;
            padding: 30px;
        }

        section {
            background-color: #F5D6A5;
            padding: 20px;
            border-radius: 10px;
        }

        h1 {
            color: #6F4E37;
        }


        #hasil {
            background-color: #fff;
            color: #3E2723;
            padding: 10px;
            border: 1px solid #ccc;
            margin-top: 10px;
        }

        button {
            margin-top: 15px;
            padding: 8px 12px;
            background: #6F4E37;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <section>
        <h1>Hasil Pemesanan</h1>
        <div id="hasil"></div>
        <button onclick="window.location.href='index.html'">Kembali</button>
    </section>
    <script src="hasil.js"></script>
</body>

</html>
